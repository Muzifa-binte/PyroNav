# Copy this file to .env and fill in your values.
# Every value below has a safe development default, so .env is optional locally.

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pyronav_db
DB_USER=pyronav_user
DB_PASSWORD=secure_password
# Connections kept open. psycopg2 CLOSES connections beyond this number when
# they are returned, so a value that is too low means a new PostgreSQL
# connection per concurrent request (p95 330 ms vs 45 ms in our load test).
DB_POOL_MIN=5
DB_POOL_MAX=20
# Seconds to wait when opening a connection before treating the DB as down
DB_CONNECT_TIMEOUT=3

# ── MQTT (Member 1) ─────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883

# ── API server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Apply pending database migrations automatically on API startup
AUTO_MIGRATE=false
# When the DB is unreachable, serve shared-contracts demo data (demo_data: true)
# instead of returning 503. Turn off in production.
DEMO_FALLBACK=true
# Enables POST /api/v1/system/events/publish (inject test events). Off in production.
ENABLE_DEV_ENDPOINTS=true
# Include exception messages in 500 responses. Off in production.
DEBUG=true

# Modules that register in-process workers (MQTT ingestion, decision engine, ...)
# so they share the API's event bus. See api/services.py.
# Default: MQTT ingestion (needs a running broker, see README) + Member 2's
# decision engine, which turns readings into room hazard levels and alerts.
# Leave it empty (BACKGROUND_SERVICES=) to run the API without either.
BACKGROUND_SERVICES=sensor_ingestion.service,decision_engine.service

# ── Logging & auditing ─────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
# Persist WARNING+ log records to the system_logs table
LOG_TO_DATABASE=true
# Persist every HTTP request to the api_audit_log table
AUDIT_LOG_ENABLED=true

# ── WebSocket ───────────────────────────────────────────────
# Seconds between server heartbeat frames (0 disables)
WS_HEARTBEAT_SECONDS=30

# ── Data retention ─────────────────────────────────────────
# Delete readings/logs/audit rows older than N days (0 disables the purge job)
RETENTION_DAYS=0
RETENTION_INTERVAL_HOURS=6
