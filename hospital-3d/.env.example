# Copy to hospital-3d/.env — every value has a working local default.

# Mosquitto WebSocket listener (backend/mqtt/mosquitto.conf → listener 9001).
# Default: ws://<host the page was opened from>:9001
VITE_MQTT_URL=ws://localhost:9001
# Only when the broker has allow_anonymous false
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
# 1 = broker confirms every reading (PUBACK); 0 = fire-and-forget
VITE_MQTT_QOS=1

# Every N seconds all sensors re-send their current value, like real devices,
# so the Decision Engine never sees them as stale (fresh window = 60 s).
# 0 disables. Can also be changed in the app (Settings tab).
VITE_PERIODIC_SECONDS=15
# While a slider is dragged, at most one message per sensor per N ms
VITE_PUBLISH_THROTTLE_MS=250

# PyroNav API used by the dev-server proxy (/api and /ws → this target)
PYRONAV_API_TARGET=http://localhost:8000
# Override only if the API is not reachable through the proxy
# VITE_API_BASE=/api/v1
# VITE_PYRONAV_WS_URL=ws://localhost:8000/ws/v1/live

# Dev server port (5173 is already in the API's default CORS_ORIGINS)
PORT=5173
