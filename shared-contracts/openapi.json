            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Room Id",
            "examples": [
              "operation_theater"
            ]
          },
          "sensor_type": {
            "type": "string",
            "enum": [
              "current",
              "smoke_heat",
              "co"
            ],
            "title": "Sensor Type"
          },
